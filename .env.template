# ==========================================
# GSK Triage Agent Configuration
# ==========================================

# --- 1. Target Repository ---
# The default GitHub repository to triage. Format: owner/repo
# Setting this here allows you to run the tool without passing the --repo CLI flag.
TARGET_REPO=owner/repo

# --- 2. GitHub Configuration ---
# Required to fetch issues and repository structure without hitting severe rate limits.
# Create a Personal Access Token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# --- 3. Model Selection ---
# Change this value to swap LLM providers instantly via LiteLLM.
# Common options: claude-3-haiku-20240307, gpt-4o-mini, gemini-1.5-flash
MODEL_NAME=claude-3-haiku-20240307

# --- 4. Provider API Keys ---
# You only need to provide the key for the provider selected in MODEL_NAME above.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- 5. Observability / Tracing (Optional) ---
# LangSmith configuration for tracing execution (if utilized).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=gsk_triage_agent